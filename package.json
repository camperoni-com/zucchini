{
  "name": "@camperoni/zucchini",
  "version": "0.1.0",
  "description": "Cucumber's opinionated cousin: generic, imperative Gherkin steps as component contracts for Storybook, rendered into a living spec.",
  "license": "MIT",
  "author": "Vasilis Georgitzikis <tzikis@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camperoni-com/zucchini.git"
  },
  "type": "module",
  "bin": {
    "zucchini": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "demo:install": "node scripts/demo-install.mjs",
    "lint": "eslint . --max-warnings 0",
    "prepack": "tsdown --logLevel error",
    "release:dry-run": "node scripts/publish-dry-run.mjs",
    "release:first": "npm publish --access public",
    "test": "vitest run",
    "test:packed": "vitest run --config vitest.packed.config.ts",
    "typecheck": "tsc -p .",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storybook": {
      "types": "./dist/storybook.d.ts",
      "default": "./dist/storybook.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./runner": {
      "types": "./dist/runner/vitest.d.ts",
      "default": "./dist/runner/vitest.js"
    },
    "./runner/preview": {
      "types": "./dist/runner/preview.d.ts",
      "default": "./dist/runner/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/cucumber-expressions": "18.1.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@lotun/vitest-cucumber": "0.5.4"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "*",
    "react": "^18.0.0 || ^19.0.0",
    "storybook": "^10.6.5",
    "vite": "^6.4.0 || ^7.0.0 || ^8.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "10.6.6",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
